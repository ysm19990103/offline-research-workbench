{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Research Workbench",
  "version": "0.3.0",
  "identifier": "org.offline-research.workbench",
  "build": {
    "beforeBuildCommand": "npm run build:desktop",
    "beforeDevCommand": "npm run build:desktop",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "windows": [{"label":"main","title":"有序 · 工作台","width":1440,"height":940,"minWidth":880,"minHeight":640}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app","dmg"],
    "icon": ["icons/icon.icns","icons/32x32.png","icons/128x128.png","icons/128x128@2x.png"],
    "category": "Productivity",
    "shortDescription": "离线任务、计时、日记与研究资料",
    "macOS": {"minimumSystemVersion":"13.3","hardenedRuntime":true,"signingIdentity":"-"}
  }
}
